# Copy to .env for local development. Names only here: never commit values.
# The private key is NEVER an environment variable; it is read from the secrets backend.

# NetSuite account ID, e.g. 1234567 or 1234567_SB1 for a sandbox
NS_ACCOUNT_ID=

# OAuth 2.0 client credentials (machine-to-machine) integration
NS_CLIENT_ID=
NS_CERT_ID=

# Concurrency slice allocated to this integration under
# Setup > Integration > Integration Management > Integration Governance.
# Keep at or below the allocated limit. Default 2.
NS_MAX_CONCURRENCY=2

# Secrets backend for the M2M private key.
#   file  -> local development only; reads NS_PRIVATE_KEY_PATH (a path OUTSIDE the repo)
#   [FILL: production backend, e.g. a cloud secrets manager adapter]
SECRETS_BACKEND=file
NS_PRIVATE_KEY_PATH=

# Skills the gateway exposes (comma separated). Empty = every skill marked enabled.
NS_AGENT_SKILLS=

# Comma-separated field ids masked in every tool result before it reaches the model.
# [FILL: PII fields, e.g. taxidnum,vatregnumber,accountnumber]
NS_AGENT_REDACT_FIELDS=

# Where the gateway appends its JSONL audit log. Default: ./audit/gateway.jsonl
NS_AGENT_AUDIT_PATH=
