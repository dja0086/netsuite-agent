# Copy to .env for local development. Names only here: never commit values.
# The gateway and its M2M settings were retired (ADR 0007, tag gateway-final). The agent builder needs no .env:
# it uses the `ant auth login` profile and the vault in managed-agents/phase0/claude-lock.json.

# NetSuite account ID of the demo account the SDF project deploys to, e.g. TSTDRV1755417.
NS_ACCOUNT_ID=

# What kind of account NS_ACCOUNT_ID is: sandbox | demo | production.
NS_TARGET_KIND=

# Repository where the builder's waiting-run check opens issues (apps/agent-builder/src/pending-check.ts).
BUILDER_ALERT_REPO=dja0086/netsuite-agent
