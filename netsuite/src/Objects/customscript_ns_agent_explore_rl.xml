<restlet scriptid="customscript_ns_agent_explore_rl">
  <name>NS Agent - Explore RESTlet</name>
  <description>Read-only global search for the ns-agent gateway. Managed in the netsuite-agent repo; do not edit in the UI.</description>
  <isinactive>F</isinactive>
  <notifyowner>F</notifyowner>
  <scriptfile>[/SuiteScripts/ns_agent/restlets/explore_rl.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_ns_agent_explore_rl">
      <title>NS Agent - Explore RESTlet</title>
      <status>RELEASED</status>
      <isdeployed>T</isdeployed>
      <loglevel>ERROR</loglevel>
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>F</allroles>
      <!-- Only the integration role may call this RESTlet. Create the role first (docs/netsuite-role.md). -->
      <audslctrole>[scriptid=customrole_ns_agent]</audslctrole>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
